POSTGRES_DB=mysub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-strong-db-password

DJANGO_SECRET_KEY=change-very-long-random-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,SERVER_IP,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,http://SERVER_IP
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,http://SERVER_IP
FRONTEND_ORIGIN=https://example.com
FRONTEND_PARTNER_BASE_URL=https://example.com

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_HOST_USER=your-project-mail@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DJANGO_DEFAULT_FROM_EMAIL=your-project-mail@gmail.com
DJANGO_EMAIL_TIMEOUT=10
DJANGO_PASSWORD_RESET_TIMEOUT=3600

NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_TENANT_SLUG=public